{% extends 'base.html.twig' %}

{% block title %}{Admin}{% endblock %}

{% block scripts %}
    {{ vite_asset('admin.ts') }}
{% endblock %}
{% block header %}{% endblock %}
{% block body %}
    <main class="h-[100vh] bg-white">
        
  

        <div class="w-full grid cols-[auto_1fr] h-full">

            {% include 'admin/partials/sidebar.html.twig' %}
        
            <div class="bg-white text-dark content w-full h-full flex flex-col">

                {% block admin_header %}{% endblock %}

                <div class="p-4 h-1 flex-grow flex flex-col">
                    {% block admin_body %}{% endblock %}
                </div>
            </div>
            <files-manager class="fixed" endpoint="/api" root-dir="/uploads"></files-manager>
    </main>
{% endblock %}
