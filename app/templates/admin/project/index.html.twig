{% extends 'admin/base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block admin_body %}
    <div class="flex justify-between items-center mb-4">
        <h1>Projets</h1>
        <a href="{{ path(prefix ~ 'new') }}">Nouveau projet</a>
    </div>

    <table class="w-full">
        <thead>
            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Titre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for project in items %}
                {% set translation = project.translation(app.request.locale) ?? project.translations|first %}
                <tr>
                    <td>{{ project.id }}</td>
                    <td>{{ project.image }}</td>
                    <td>{{ translation ? translation.title : '' }}</td>
                    <td>
                        <a href="{{ path(prefix ~ 'edit', {id: project.id}) }}">Éditer</a>
                        <form method="post" action="{{ path(prefix ~ 'delete', {id: project.id}) }}" class="inline" onsubmit="return confirm('Supprimer ce projet ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                            <button type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun projet.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="mt-4">{{ knp_pagination_render(items) }}</div>
{% endblock %}
