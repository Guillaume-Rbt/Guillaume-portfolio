{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.project.list'|trans }}{% endblock %}

{% block admin_header %}{% include 'admin/partials/admin-header.html.twig' with {
        title: 'admin.project.list'|trans,
        action: 'admin.project.new'|trans,
        prefix: prefix,
        path: 'new'
    } %}{% endblock %}

{% block admin_body %}
   

    <table class="w-full">
        <thead>
            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Titre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for project in items %}
                {% set translation = project.translation(app.request.locale) ?? project.translations|first %}
                <tr>
                    <td>{{ project.id }}</td>
                    <td>{{ project.image }}</td>
                    <td>{{ translation ? translation.title : '' }}</td>
                    <td>
                        <a class="btn btn-primary" href="{{ path(prefix ~ 'edit', {id: project.id}) }}">{{ 'admin.project.edit'|trans }}</a>
                        <form method="post" action="{{ path(prefix ~ 'delete', {id: project.id}) }}" class="inline" onsubmit="return confirm('Supprimer ce projet ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                            <button class="btn btn-danger" type="submit">{{ 'admin.project.delete'|trans }}</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun projet.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="mt-4">{{ knp_pagination_render(items) }}</div>
{% endblock %}
